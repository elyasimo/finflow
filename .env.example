# ===============================
# Finflow Environment Variables
# ===============================

# ----- Database -----
DATABASE_URL=postgresql://finflow:secret@localhost:5432/finflow
POSTGRES_USER=finflow
POSTGRES_PASSWORD=secret
POSTGRES_DB=finflow

# ----- API Server -----
NODE_ENV=development
API_PORT=8080
API_HOST=0.0.0.0

# JWT Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-please-change-this
JWT_EXPIRES_IN=7d

# Bcrypt Rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# ----- CORS -----
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- External APIs -----
# Alpha Vantage (optional, for stock/crypto prices)
ALPHA_VANTAGE_KEY=KLTVR3LKBF1VGPLF
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Yahoo Finance (no key needed, fallback)
YAHOO_FINANCE_ENABLED=true

# ----- File Storage -----
UPLOAD_MAX_SIZE_MB=10
ATTACHMENTS_PATH=/app/data/attachments

# ----- Frontend (Flutter Web Build) -----
FLUTTER_WEB_PORT=3000

# ----- pgAdmin (optional) -----
PGADMIN_DEFAULT_EMAIL=admin@finflow.app
PGADMIN_DEFAULT_PASSWORD=admin

# ----- E2E Encryption (optional) -----
# Enable E2E encryption for sensitive fields (notes, descriptions)
E2E_ENCRYPTION_ENABLED=false

# ----- API Keys Encryption -----
# Master encryption key for encrypting API keys (Binance, Alpaca, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Keep this secret and never commit to version control!
ENCRYPTION_MASTER_KEY=your-64-char-hex-encryption-master-key-change-this-immediately

# ----- Trading APIs -----
# Alpaca Trading (Paper Trading)
# ⚠️ NEVER commit real trading API keys to git!
# Get paper trading keys at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=YOUR_ALPACA_PAPER_API_KEY_HERE
ALPACA_API_SECRET=YOUR_ALPACA_PAPER_API_SECRET_HERE
ALPACA_PAPER_TRADING=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Binance Trading
# ⚠️ NEVER commit real trading API keys to git!
# For development: Use testnet
# For production: Use encrypted secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
BINANCE_API_BASE=https://api.binance.com
BINANCE_API_TESTNET_BASE=https://testnet.binance.vision
BINANCE_USE_TESTNET=false
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE

# Trading Agent (disabled by default for safety)
ENABLE_TRADING_AGENT=false

# ----- Logging -----
LOG_LEVEL=info
# Options: error, warn, info, debug

# ----- Production Checklist -----
# Before deploying to production:
# 
# 1. ✅ Change NODE_ENV to 'production'
# 2. ✅ Generate new JWT_SECRET (openssl rand -base64 64)
# 3. ✅ Generate new ENCRYPTION_MASTER_KEY (openssl rand -hex 32)
# 4. ✅ Update DATABASE_URL with production credentials
# 5. ✅ Update CORS_ORIGIN with your production domain
# 6. ✅ Move API keys to secrets manager (AWS Secrets, Vault, etc.)
# 7. ✅ Set strong POSTGRES_PASSWORD
# 8. ✅ Enable HTTPS only
# 9. ✅ Set up database backups
# 10. ✅ Configure monitoring and alerting
# 11. ✅ Review rate limits for production traffic
# 12. ✅ Enable database connection pooling
# 13. ✅ Set up CDN for static assets
# 14. ✅ Configure proper logging (ELK, CloudWatch, etc.)
# 15. ✅ Rotate all exposed API keys immediately

# ----- PRODUCTION EXAMPLE (commented) -----
# NODE_ENV=production
# DATABASE_URL=postgresql://finflow_prod:STRONG_SECURE_PASSWORD@rds-instance.region.rds.amazonaws.com:5432/finflow_prod
# JWT_SECRET=USE_AWS_SECRETS_MANAGER_OR_ENV_VARS_INJECTION
# ENCRYPTION_MASTER_KEY=USE_AWS_SECRETS_MANAGER_OR_ENV_VARS_INJECTION
# CORS_ORIGIN=https://app.finflow.io
# BINANCE_API_KEY=USE_AWS_SECRETS_MANAGER
# BINANCE_API_SECRET=USE_AWS_SECRETS_MANAGER
# ALPACA_API_KEY=USE_AWS_SECRETS_MANAGER
# ALPACA_API_SECRET=USE_AWS_SECRETS_MANAGER
