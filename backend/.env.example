# FinFlow Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/finflow

# ===========================================
# JWT SECRET
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

# ===========================================
# EMAIL (SMTP) - Primary: Microsoft 365
# ===========================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@finflowapp.ch
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@finflowapp.ch
SMTP_FROM_NAME=FinFlow

# ===========================================
# EMAIL (Gmail Fallback)
# ===========================================
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your-app-password
# GMAIL_FROM_NAME=FinFlow

# ===========================================
# PUSH NOTIFICATIONS - Firebase Cloud Messaging (FCM)
# Recommended for both Android and iOS
# ===========================================
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Note: Replace \n with actual newlines or use \\n in the .env file
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ===========================================
# PUSH NOTIFICATIONS - Apple Push Notification Service (APNs)
# Only needed if not using FCM for iOS
# ===========================================
# Get these from Apple Developer Portal -> Certificates, Identifiers & Profiles -> Keys
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAMID1234
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APNS_KEY_HERE\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=ch.finflowapp.app
# Set to 'false' for development/sandbox environment
APNS_PRODUCTION=true

# ===========================================
# TRADING APIs
# ===========================================
# Binance API (for crypto trading)
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
# Use testnet for development
BINANCE_TESTNET=true

# Alpaca API (for stock trading)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-api-secret
# Use paper trading for development
ALPACA_PAPER=true

# ===========================================
# OPENAI (for AI features)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# SALT EDGE (for bank connections)
# ===========================================
SALT_EDGE_APP_ID=your-app-id
SALT_EDGE_SECRET=your-secret

# ===========================================
# PLAID (alternative for bank connections)
# ===========================================
# PLAID_CLIENT_ID=your-client-id
# PLAID_SECRET=your-secret
# PLAID_ENV=sandbox

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=development
