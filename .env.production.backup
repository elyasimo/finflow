# ----- Database -----
# CRITICAL: Update with your production database host/port after deployment
DATABASE_URL=postgresql://finflow_prod:XPXNBPM1IAsyJFNaGGqMXjh2dr300dMQU47aZam1VAU=@postgres:5432/finflow_production

# Database Credentials (strong generated passwords)
POSTGRES_USER=finflow_prod
POSTGRES_PASSWORD=XPXNBPM1IAsyJFNaGGqMXjh2dr300dMQU47aZam1VAU=
POSTGRES_DB=finflow_production

# Database Connection Details (for Coolify internal networking)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finflow_production
DB_USER=finflow_prod
DB_PASSWORD=XPXNBPM1IAsyJFNaGGqMXjh2dr300dMQU47aZam1VAU=

# ----- API Server -----
NODE_ENV=production
API_PORT=8080
API_HOST=0.0.0.0

# ----- JWT Authentication -----
# Strong 64-character secret (generated with openssl rand -base64 64)
JWT_SECRET=3IvcYqWBqjxbqwzNquWVDzhxvT9wi/4MnuMQoQpYK7s/BCyNa3NgJC5e4hMJBwq5++bzA2w6lhwDHaqXSbI5IA==
JWT_EXPIRES_IN=7d

# Bcrypt Rounds (production recommended)
BCRYPT_ROUNDS=12

# ----- CORS -----
# ⚠️ CRITICAL: Update with your actual domain after Coolify deployment
# Remove the localhost entries and add your production domain
# Example: https://finflow.yourdomain.com,https://api.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ----- Rate Limiting (Production tuned) -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- External APIs -----
# Alpha Vantage (stock/crypto prices - free tier)
ALPHA_VANTAGE_KEY=KLTVR3LKBF1VGPLF
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Yahoo Finance (fallback, no key needed)
YAHOO_FINANCE_ENABLED=true

# ----- Trading APIs -----
# ⚠️ CRITICAL SECURITY: The API keys below are PLACEHOLDERS
# ⚠️ BEFORE DEPLOYMENT: Generate NEW keys with IP whitelist restrictions

# Alpaca Trading (Paper Trading)
# 🔴 ACTION REQUIRED: Get NEW keys from https://app.alpaca.markets/paper/dashboard/overview
# Steps: 1. Login to Alpaca → 2. Paper Trading → 3. API Keys → 4. Regenerate or Create New
ALPACA_API_KEY=YOUR_NEW_ALPACA_PAPER_API_KEY_HERE
ALPACA_API_SECRET=YOUR_NEW_ALPACA_PAPER_API_SECRET_HERE
ALPACA_PAPER_TRADING=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Binance Trading
# 🔴 ACTION REQUIRED: Create NEW keys at https://www.binance.com/en/my/settings/api-management
# ⚠️ OLD KEY WAS EXPOSED: jquHsf...490C - DELETE IT!
# Security Requirements for NEW key:
# 1. ✓ Enable Reading ONLY (no trading/withdrawal permissions)
# 2. ✓ Restrict access to trusted IPs (add your VPS IP: e.g., 95.217.x.x)
# 3. ✓ Key name: "Finflow Production VPS - Read Only"
# 4. ✗ Disable: Enable Spot & Margin Trading
# 5. ✗ Disable: Enable Futures
# 6. ✗ Disable: Enable Withdrawals
BINANCE_API_BASE=https://api.binance.com
BINANCE_API_TESTNET_BASE=https://testnet.binance.vision
BINANCE_USE_TESTNET=false
BINANCE_API_KEY=YOUR_NEW_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_NEW_BINANCE_API_SECRET_HERE

# Trading Agent (disabled by default for safety)
ENABLE_TRADING_AGENT=false

# ----- File Storage -----
UPLOAD_MAX_SIZE_MB=10
ATTACHMENTS_PATH=/app/data/attachments

# ----- pgAdmin (Development Tool) -----
PGADMIN_DEFAULT_EMAIL=admin@finflow.app
PGADMIN_DEFAULT_PASSWORD=cOTpsW+JBfT+CNJNP/IDS2FtKvLHIbVX

# ----- Encryption -----
# CRITICAL: Master encryption key for encrypting API keys in database
# Generated with: openssl rand -hex 32
# This key encrypts user's trading API keys before storing in DB
ENCRYPTION_MASTER_KEY=98b5d0e8dd2d721d858d195fccfaa6bea603b962ce00e0c8f34904b8067c8709

# ----- Logging -----
LOG_LEVEL=info
# Options: error, warn, info, debug

# ----- Coolify Deployment Notes -----
# 1. Upload this file to Coolify as Environment Variables
# 2. Update CORS_ORIGIN with your domain (e.g., https://finflow.yourdomain.com)
# 3. Coolify will automatically handle:
#    - Internal Docker networking (postgres service)
#    - SSL/TLS certificates (Let's Encrypt)
#    - Container orchestration
#    - Health checks
# 4. After deployment, create NEW Binance/Alpaca keys and update:
#    - BINANCE_API_KEY
#    - BINANCE_API_SECRET
#    - ALPACA_API_KEY
#    - ALPACA_API_SECRET
# 5. Enable IP whitelist on Binance API key (restrict to VPS IP)
